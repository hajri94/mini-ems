# mini-ems settings. Copy this file to .env and change the values there.
# Never put real passwords in this file: it is committed to Git.

# --- Application (optional; the values below are the defaults) ---

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL
MINI_EMS_LOG_LEVEL=INFO

# Site location in decimal degrees, with a dot (43.26, not 43,26)
MINI_EMS_LATITUDE=43.26
MINI_EMS_LONGITUDE=-2.93

# --- Database (not used yet; needed from Week 2) ---

# Read by the TimescaleDB container on its first start
POSTGRES_USER=ems
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ems

# Read by the ingest and API services to find the database container
POSTGRES_HOST=db
POSTGRES_PORT=5432
